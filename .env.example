# Public (safe for the browser) - from Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# SERVER ONLY - never expose. Supabase: Project Settings -> API -> service_role key.
# Add it in Vercel as a normal (non "NEXT_PUBLIC_") variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Random string protecting the daily cleanup cron (Vercel sends it automatically as a Bearer token).
CRON_SECRET=change-me-to-a-long-random-string

# Optional: your public site URL, used for share links / Open Graph (e.g. https://kpai.vercel.app)
NEXT_PUBLIC_SITE_URL=
